generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  image       String    @default("")
  description String    @default("")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  image       String   @default("")
  gallery     String   @default("[]")
  summary     String   @default("")
  description String   @default("")
  specs       String   @default("[]")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
}

model Media {
  id          String   @id @default(cuid())
  name        String
  url         String
  alt         String   @default("")
  description String   @default("")
  size        Int      @default(0)
  type        String   @default("")
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())
}

model Inquiry {
  id                    String   @id @default(cuid())
  fullName              String
  companyName           String   @default("")
  businessEmail         String
  phone                 String   @default("")
  country               String   @default("")
  productType           String   @default("")
  quantity              String   @default("")
  packagingSize         String   @default("")
  material              String   @default("")
  printingRequirements  String   @default("")
  additionalRequirements String  @default("")
  attachments           String   @default("[]")
  status                String   @default("pending")
  note                  String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Visit {
  id        String   @id @default(cuid())
  sessionId String
  ip        String   @default("")
  path      String   @default("/")
  referer   String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([ip])
}
