# ============================================================================
#  Copy to docs1/.env and fill in real values.
#  Never commit docs1/.env — it is ignored by .gitignore.
# ============================================================================

# --- PostgreSQL (used by docker-compose.yml) --------------------------------
POSTGRES_USER=jintaihong
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=jintaihong
POSTGRES_PORT=5432
TZ=Asia/Shanghai

# --- Application connection string (used by Prisma / future backend) --------
# If the password contains special characters, percent-encode them.
DATABASE_URL=postgresql://jintaihong:change-this-to-a-long-random-password@localhost:5432/jintaihong?schema=public

# --- Future backend settings (not implemented in this package) --------------
# PORT=4000
# CORS_ORIGIN=http://localhost:5173
# SESSION_SECRET=replace-with-32-plus-random-bytes
# UPLOAD_DIR=./server/uploads
# MAX_UPLOAD_MB=10
